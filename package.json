{
  "name": "247gbs-expo",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w apps/web",
    "dev:web": "npm run dev -w apps/web",
    "dev:backend": "npm run start:dev -w apps/backend",
    "build": "npm run build:web && npm run build:backend",
    "build:web": "npm run build -w apps/web",
    "build:backend": "npm run build -w apps/backend",
    "typecheck": "npm run typecheck:web && npm run typecheck:backend",
    "typecheck:web": "npm run typecheck -w apps/web",
    "typecheck:backend": "npm run typecheck -w apps/backend",
    "lint": "npm run lint -w apps/web",
    "lint:backend": "npm run lint -w apps/backend",
    "test:backend": "npm run test -w apps/backend",
    "prisma:generate": "prisma generate --schema apps/backend/prisma/schema.prisma",
    "postinstall": "npm run prisma:generate"
  }
}
